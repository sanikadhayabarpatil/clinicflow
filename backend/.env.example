APP_NAME=ClinicFlow
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production

# SQLite for local dev (swap for Supabase PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./clinicflow.db

# Path to trained model artifacts
MODEL_DIR=./artifacts

# Intervention costs (USD)
COST_SMS=0.05
COST_CALL=0.50
COST_OVERBOOK=2.00
REVENUE_PER_APPOINTMENT=150.0

# Optional: Google Gemini for copilot feature
GEMINI_API_KEY=
